# Copia este archivo a .env.local. Para el modo local no hace falta nada:
# todos los valores tienen un defecto sensato.

# ============================================================
# Motor de try-on (cliente)
# ============================================================
# local-pose -> MediaPipe en el navegador. Tiempo real, sin red, sin API key.
# mock       -> Prenda en posición fija, sin IA. Para desarrollar la UI.
# remote     -> Difusión por API vía /api/try-on. No es tiempo real.
NEXT_PUBLIC_TRYON_ENGINE=local-pose

# ============================================================
# Proveedor remoto (sólo si NEXT_PUBLIC_TRYON_ENGINE=remote)
# ============================================================
# Sin prefijo NEXT_PUBLIC_ a propósito: estas variables las lee únicamente el
# servidor, en app/api/try-on. Si les pusieras el prefijo, la API key acabaría
# dentro del bundle que se descarga el navegador.
# TRYON_PROVIDER=fashn
# FASHN_API_KEY=
# FASHN_MODEL_NAME=tryon-v1.6
