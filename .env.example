# Variables de Entorno - Virtual Try-On E-Commerce

# ========================================
# VTON Provider Configuration
# ========================================
# Opciones: mock, replicate, fashn, decart
NEXT_PUBLIC_VTON_PROVIDER=mock

# ========================================
# Replicate (Virtual Try-On via Replicate)
# ========================================
# Obtén tu API Key en: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=your_replicate_api_key_here

# Modelo VTON a usar (IDM-VTON es el más popular)
VTON_MODEL_ID=sczhou/iidm-vton:8ee0c3c9a0fa3dd1e8b38f37e8a0fdb78c63cbea2a8fac8b8b2c5c8a9e8b8b8b

# ========================================
# Fashn.ai (Especializado en Virtual Try-On)
# ========================================
# Obtén tu API Key en: https://fashn.ai/
FASHN_API_KEY=your_fashn_api_key_here
VTON_ENDPOINT=https://api.fashn.ai/v1/try-on

# ========================================
# Decart AI / Anywear (Solución Empresarial)
# ========================================
# Obtén credenciales en: https://decart.ai/
DECART_API_KEY=your_decart_api_key_here

# ========================================
# WebSocket Configuration (para streaming en vivo)
# ========================================
VTON_WS_URL=wss://api.ejemplo.com/vton-stream

# ========================================
# Analytics & Monitoring (Opcional)
# ========================================
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id
SENTRY_DSN=your_sentry_dsn

# ========================================
# Base de Datos (Si aplica)
# ========================================
DATABASE_URL=postgresql://user:password@localhost:5432/vton_db
REDIS_URL=redis://localhost:6379

# ========================================
# Notas:
# ========================================
# 1. Este archivo NO debe ser commiteado a git
# 2. En producción, configura estas variables en tu plataforma de hosting
# 3. Mantén tus API Keys privadas y seguras
# 4. Para desarrollo, copiar a .env.local
